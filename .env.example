# Chemistry Live: Environment Configuration Example
# Copy this file to .env.local or .env for local development

# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous / Publishable Key (safe for client-side)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role / Secret Key (server-side only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Settings
NODE_ENV=development
PORT=3000
